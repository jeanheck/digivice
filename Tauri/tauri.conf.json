{
  "$schema": "../Frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "digivice",
  "version": "0.1.0",
  "identifier": "com.digivice.app",
  "build": {
    "frontendDist": "../Frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../Frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../Frontend"
    },
    "beforeBundleCommand": {
      "script": "powershell -ExecutionPolicy Bypass -File ../Tauri/scripts/copy-sidecar-runtime.ps1",
      "cwd": "../Frontend"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Digivice",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend"
    ],
    "resources": {
      "binaries/appsettings.json": "appsettings.json",
      "binaries/Memory/": "Memory/"
    }
  }
}
